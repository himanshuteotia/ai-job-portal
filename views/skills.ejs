<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Skills</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body { font-family: Arial, sans-serif; background: #f4f4f4; }
        .container { max-width: 700px; margin: 40px auto; background: #fff; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; }
        h1 { color: #388e3c; text-align: center; margin-bottom: 32px; }
        .add-skill-form { display: flex; gap: 12px; margin-bottom: 28px; }
        .add-skill-form input { flex: 1; padding: 10px; border-radius: 6px; border: 1.5px solid #81c784; font-size: 16px; }
        .add-skill-form button { padding: 10px 22px; border-radius: 6px; background: #4caf50; color: #fff; border: none; font-size: 1em; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        .add-skill-form button:hover { background: #388e3c; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { padding: 12px 8px; text-align: left; }
        th { background: #e8f5e9; color: #2e7d32; font-size: 1.1em; }
        tr:nth-child(even) { background: #f7fff7; }
        .verified-toggle { cursor: pointer; font-size: 1.2em; }
        .verified-true { color: #4caf50; }
        .verified-false { color: #aaa; }
    </style>
</head>
<body>
    <div class="container">
        <h1><i class="fas fa-cogs"></i> Manage Skills</h1>
        <form class="add-skill-form" id="addSkillForm">
            <input type="text" id="newSkillInput" placeholder="Enter new skill" required />
            <button type="submit"><i class="fas fa-plus"></i> Add Skill</button>
        </form>
        <table>
            <thead>
                <tr>
                    <th>Skill Name</th>
                    <th>Verified</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody id="skillsTableBody">
                <!-- Skills will be rendered here -->
            </tbody>
        </table>
    </div>
    <script>
        async function fetchSkills() {
            const res = await fetch('/api/skills?all=true');
            return await res.json();
        }
        function renderSkills(skills) {
            const tbody = document.getElementById('skillsTableBody');
            tbody.innerHTML = skills.map(skill => `
                <tr data-id="${skill._id}">
                    <td>${skill.name}</td>
                    <td>
                        <span class="verified-toggle ${skill.verified ? 'verified-true' : 'verified-false'}" data-id="${skill._id}" data-verified="${skill.verified}">
                            <i class="fas fa-check-circle"></i>
                        </span>
                    </td>
                    <td>
                        ${!skill.verified ? `<button class="delete-skill-btn" data-id="${skill._id}" style="background:none;border:none;cursor:pointer;color:#e53935;font-size:1.2em;"><i class="fas fa-trash"></i></button>` : ''}
                    </td>
                </tr>
            `).join('');
        }
        async function loadSkills() {
            const skills = await fetchSkills();
            renderSkills(skills);
        }
        document.getElementById('addSkillForm').onsubmit = async function(e) {
            e.preventDefault();
            const input = document.getElementById('newSkillInput');
            const name = input.value.trim().toLowerCase();
            if (!name) return;
            await fetch('/api/skills', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            input.value = '';
            await loadSkills();
        };
        let errorMsg = document.createElement('div');
        errorMsg.id = 'skill-error-msg';
        errorMsg.style.color = '#e53935';
        errorMsg.style.margin = '10px 0 0 0';
        document.querySelector('.container').prepend(errorMsg);
        document.getElementById('skillsTableBody').onclick = async function(e) {
            const target = e.target.closest('.verified-toggle');
            if (target) {
                const id = target.getAttribute('data-id');
                const verified = target.getAttribute('data-verified') === 'true';
                await fetch(`/api/skills/${id}/verify`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ verified: !verified })
                });
                await loadSkills();
                return;
            }
            const delBtn = e.target.closest('.delete-skill-btn');
            if (delBtn) {
                const id = delBtn.getAttribute('data-id');
                if (confirm('Are you sure you want to delete this skill?')) {
                    errorMsg.textContent = '';
                    const row = delBtn.closest('tr');
                    const res = await fetch(`/api/skills/${id}`, { method: 'DELETE' });
                    if (res.ok) {
                        row.remove();
                    } else {
                        const data = await res.json();
                        errorMsg.textContent = data.message || 'Could not delete skill.';
                    }
                }
            }
        };
        loadSkills();
    </script>
</body>
</html> 